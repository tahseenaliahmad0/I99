+## Begins the leg he is on again from its start, with nothing on its road.
+func _quiet_this_leg() -> void:
+	var plan: Dictionary = RunGenerator.plan(data, _sim.run.branch, _sim.run.act)
+	for key: String in ["spawns", "hazards", "curves", "gusts", "zones"]:
+		plan[key] = []
+	for key: String in ["flock", "melons", "motorcade"]:
+		plan[key] = {}
+	_sim.gate.reset(3)
+	_sim.begin_leg(plan)
+	_sim.in_encounter = true
+	_sim.drain_events()
+
+
+## Steps until the phone rings, on a Telling's leg: the car is held back
+## short of the Exit so that the leg does not end while he waits.
+func _await_ring_on_leg() -> bool:
+	var guard: int = _ticks_in(GameData.as_float(GameData.as_array(_params("phone").get("call_gap_s"))[1]) + 10.0)
+	while _sim.items.caller == &"" and guard > 0:
+		guard -= 1
+		_sim.car.s = minf(_sim.car.s, _sim.leg.length * 0.1)
+		_tick()
+	return _sim.items.caller != &""
+
+
 ## Into the slip lane and to the stall in second gear: he stops. (A stop
 ## makes the simulation anew from what a save holds: look items up again.)
 func _into_stall() -> void:

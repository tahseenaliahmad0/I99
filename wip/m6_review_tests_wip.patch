+## What Focus must leave to him and what it must slow with the road (D-041),
+## beyond what _a_second_of_road() reads; with a can drunk first, or not.
+## His own: how much the tea cools and the glass blurs in a second, what a
+## second on the rough shoulder does to his Nerves, how many ticks a grind
+## locks the lever. The road's: how many ticks the immunity after a hit
+## lasts, how far the leg's encounter and a gust's tell get in a second (half
+## a second for the tell), how far a sheep of a flock walks in a second, and
+## how many of two potholes 4 m apart count as hits.
+func _focus_readings(focused: bool) -> Dictionary:
+	var hold_s: float = GameData.as_float(_ritual("energy_drink_sip").get("hold_s"))
+	var out: Dictionary = {}
+	_new_sim()
+	_give("energy_drink")
+	if focused:
+		_hold_at(_anchor_of("energy_drink"), hold_s)
+	check_eq(_sim.effects.has(&"focus"), focused, "(Focus: %s)" % str(focused))
+	var glass: ItemSim.Item = _item("tea_glass")
+	var hot: float = glass.hot_left
+	var blurred: float = _sim.items.since_wipe
+	_run(1.0)
+	out["tea"] = hot - glass.hot_left
+	out["since_wipe"] = _sim.items.since_wipe - blurred
+	# The rough shoulder.
+	_cruise(3, 1)
+	_input.clear()
+	_keep_lane = false
+	var shoulder_x: float = _sim.car.road_right() + tuning.f("rumble_strip_width") + tuning.f("shoulder_width") * 0.5
+	_sim.car.x = shoulder_x
+	_tick()
+	_sim.nerves.set_value(30.0)
+	for _index: int in DriveSim.TICKS_PER_SECOND:
+		_sim.car.x = shoulder_x
+		_tick()
+	out["nerves"] = _sim.nerves.value - 30.0
+	_keep_lane = true
+	# The lever after a grind.
+	_cruise(3, 1)
+	_sim.gate.lock_left = tuning.f("gate_grind_lock")
+	var locked: int = 0
+	while _sim.gate.lock_left > 0.0 and locked < 1000:
+		locked += 1
+		_tick()
+	out["gate_lock"] = locked
+	# A scrape, and the ticks until he can be hit again.
+	_cruise(3, 1)
+	var guard: int = _ticks_in(5.0)
+	while _sim.collision.immunity_left <= 0.0 and guard > 0:
+		guard -= 1
+		_sim.car.x = _sim.car.guardrail_x()
+		_sim.step(_input)
+	var immune: int = 0
+	while _sim.collision.immunity_left > 0.0 and immune < 1000:
+		immune += 1
+		_tick()
+	out["immune"] = immune
+	# A leg with an encounter: its clock, and a gust's tell.
+	_begin_quiet_leg("patrol", 2, 71)
+	_give("energy_drink")
+	if focused:
+		_hold_at(_anchor_of("energy_drink"), hold_s)
+	var clock: float = _sim.encounter.time
+	_run(1.0)
+	out["encounter"] = _sim.encounter.time - clock
+	_sim.leg.gust_tell_left = 1.0
+	_run(0.5)
+	out["gust_tell"] = 1.0 - _sim.leg.gust_tell_left
+	# A leg with a flock on it: a sheep walking.
+	_sim = DriveSim.new(fresh_data())
+	_events = []
+	_input.clear()
+	var plan: Dictionary = LegGenerator.generate(data, "open_road", 2, 5, "sheep")
+	for key: String in ["spawns", "hazards", "curves", "gusts", "zones"]:
+		plan[key] = []
+	_sim.gate.reset(3)
+	_sim.begin_leg(plan)
+	_sim.drain_events()
+	_give("energy_drink")
+	if focused:
+		_hold_at(_anchor_of("energy_drink"), hold_s)
+	_sim.car.s = GameData.as_float(GameData.as_dict(plan.get("flock")).get("start_s")) + 1.0
+	_tick()
+	out["sheep"] = 0.0
+	if not _sim.leg.movers.is_empty():
+		var sheep: LegSim.Hazard = _sim.leg.movers[0]
+		var sheep_x: float = sheep.x
+		_run(1.0)
+		out["sheep"] = absf(sheep.x - sheep_x)
+	# Two potholes 4 m apart in his lane: the second lies wholly inside the
+	# first one's pothole_cooldown of road, so it does not count.
+	plan["flock"] = {}
+	plan["hazards"] = [{"kind": "pothole", "s": 300.0, "x": _sim.car.lane_center(GameData.as_int(plan.get("start_lane")))},
+			{"kind": "pothole", "s": 304.0, "x": _sim.car.lane_center(GameData.as_int(plan.get("start_lane")))}]
+	_sim = DriveSim.new(fresh_data())
+	_events = []
+	_input.clear()
+	_sim.gate.reset(3)
+	_sim.begin_leg(plan)
+	_sim.drain_events()
+	_give("energy_drink")
+	if focused:
+		_hold_at(_anchor_of("energy_drink"), hold_s)
+	var potholes: int = 0
+	guard = _ticks_in(30.0)
+	while _sim.car.s < 340.0 and guard > 0:
+		guard -= 1
+		_tick()
+		for kind: StringName in _sim.leg.hits:
+			if kind == &"pothole":
+				potholes += 1
+	out["potholes"] = potholes
+	return out
+
+
 ## Steps until the phone rings (at most a little over the longest gap).
 func _await_ring() -> bool:
 	var guard: int = _ticks_in(GameData.as_float(GameData.as_array(_params("phone").get("call_gap_s"))[1]) + 10.0)
